                "pedidos"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "A_CAMINHO"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Forma 2 — JPQL: pedidos do cliente por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{administrativo}}/api/v1/clientes/{{clienteId}}/pedidos/por-categoria?categoria=Italiana",
